# Backend Server Configuration
APP_NAME=Intelligent Document-to-Chatbot Pipeline
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths (relative to project root or absolute)
DATA_PDF_DIR=../data/pdfs
EXTRACTED_DATA_DIR=../extracted_data
CHUNK_OUTPUTS_DIR=../chunk_outputs
VECTOR_STORE_DIR=../vector_store

# Phase 6 Embedding Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Phase 8 Gemini RAG Settings (keep real GEMINI_API_KEY only in local .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Extraction & OCR Settings
MIN_MEANINGFUL_TEXT_CHARS=40
MIN_ALPHA_CHARS=15
OCR_DPI=200
OCR_ENGINE=auto
MAX_UPLOAD_SIZE_MB=50

